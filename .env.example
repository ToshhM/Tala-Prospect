# Database Connection (Supabase PostgreSQL / standard Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talaprospect?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/talaprospect?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Auth credentials (for OAuth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# France Travail API credentials
FRANCE_TRAVAIL_CLIENT_ID="your-france-travail-client-id"
FRANCE_TRAVAIL_CLIENT_SECRET="your-france-travail-client-secret"

# Secret used to authenticate Vercel Cron calls to /api/cron/sync-all
# Without it, the sync endpoint is callable by anyone. Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
